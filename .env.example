# For LOCAL runs only (export in your shell). On GitHub use Repository Secrets - never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twelve Data - FOUR keys, 7 Forex pairs each (see config.py / README)
TWELVE_DATA_API_KEY_1=
TWELVE_DATA_API_KEY_2=
TWELVE_DATA_API_KEY_3=
TWELVE_DATA_API_KEY_4=
# Optional DEDICATED key for XAU/USD (accounted separately; never uses a forex key's credits)
TWELVE_DATA_API_KEY_GOLD=
# Optional: explicitly let gold share forex key N (1-4) instead. NOT recommended: 672+96 > scheduled limit 720
# GOLD_TWELVE_SHARE_KEY=

# Optional live CFD source for XAUUSD and NAS100 (OANDA XAU_USD / NAS100_USD)
OANDA_API_TOKEN=
# OANDA_ENV=practice            # or live

# AlgoSpecial timestamps are broker server time. AlgoSpecial stays DISABLED until you set the verified UTC offset
# (e.g. 2 or 3). Even then it must pass the freshness gate (it documents a historical dataset).
# ALGOSPECIAL_UTC_OFFSET_HOURS=

# Quotas (Twelve Data Basic plan: 8 credits/min, 800/day per key). Enforced - cannot be disabled.
# TWELVE_DATA_DAILY_BUDGET=800
# TWELVE_DATA_RETRY_RESERVE=80
# TWELVE_DATA_RPM=8

# Optional
# STATE_DB_PATH=state/state.db
# DRY_RUN=false
# EVALUATE_FORMING_CANDLE=false          # keep false: Pine acts on closed bars only
# GOLD_PROVIDER_ORDER=algospecial,twelvedata,oanda
# NAS100_PROVIDER_ORDER=algospecial,oanda   # CFD sources only; other names are ignored
# PO3_ALGORITHM_MODE="Small Manipulation"   # Short Accumulation | Big Manipulation
# PO3_BREAKOUT_METHOD=Wick                  # Close
# PO3_TPSL_METHOD=Dynamic                   # Fixed
# PO3_RISK=Normal                           # Highest|High|Low|Lowest
